OPENROUTER_API_KEY=sk-or-your-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_REASONING_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Nano Banana przez OpenRouter, używa OPENROUTER_API_KEY
NANOBANANA_MODEL=google/gemini-2.5-flash-image

# Opcjonalnie: walidacja adresu przez Google Geocoding API przed zapytaniem ULDK/Geoportal
GOOGLE_MAPS_API_KEY=
OSM_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Optional local CubiCasa5K-compatible parser command.
# The command receives a normalized image path and must print JSON.
CUBICASA5K_COMMAND=
ENABLE_3D_VISUALIZATION=false
ENABLE_PLAYWRIGHT_GALLERY_SCAN=true
PLAYWRIGHT_TIMEOUT_SECONDS=18

APP_URL=http://127.0.0.1:8001
APP_NAME=FlatWise
REQUEST_TIMEOUT_SECONDS=18
MAX_UPLOAD_BYTES=12582912
MAX_IMAGE_PIXELS=24000000
MAX_PDF_PAGES=6
ALLOW_PRIVATE_LISTING_URLS=false
CORS_ORIGINS=http://127.0.0.1:8001
